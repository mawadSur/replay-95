{
  "expo": {
    "name": "Replay '95",
    "slug": "replay-95",
    "scheme": "replay95",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A0E26"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Replay '95 to record voice memories."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Replay '95 to capture memory booth moments."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "nightly-memory"
        }
      ],
      "@sentry/react-native",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mawadSur.replay95",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Replay '95 to capture memory booth moments.",
        "NSMicrophoneUsageDescription": "Allow Replay '95 to record voice memories.",
        "NSPhotoLibraryAddUsageDescription": "Save memory booth photos to your camera roll.",
        "NSUserNotificationsUsageDescription": "Replay '95 sends a nightly Memory Channel reminder."
      }
    },
    "android": {
      "package": "com.mawadSur.replay95",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0E26"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f973a1f-5480-4524-9c55-de8c7fc461dd"
      }
    },
    "owner": "kjjungle0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7f973a1f-5480-4524-9c55-de8c7fc461dd"
    }
  }
}
